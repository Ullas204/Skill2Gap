# App
APP_NAME=HireSim AI
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/hire
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://redis:6379/0

# Auth
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# SMTP (optional - for email verification and invitation delivery)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Frontend base URL used to build invitation links ({FRONTEND_BASE_URL}/invite/{token})
FRONTEND_BASE_URL=http://localhost:5173

# Invitation expiry in hours (default 72)
INVITATION_EXPIRATION_HOURS=72

# Organization Bootstrap (for demo/development)
BOOTSTRAP_ORG_ADMIN_EMAIL=
BOOTSTRAP_ORG_ADMIN_PASSWORD=

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hire

# LLM Providers (at least one required for AI features)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Ollama (local LLM, optional)
OLLAMA_URL=
OLLAMA_MODEL=llama3

# LLM Settings
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# OpenAI (for speech-to-text, optional)
OPENAI_API_KEY=
